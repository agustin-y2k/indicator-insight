# Local development only. Replace the placeholder before starting Compose.
POSTGRES_USER=indicator
POSTGRES_DB=indicator
POSTGRES_PASSWORD=replace-with-local-password
# URL-encode reserved characters in the password in this connection URL.
DATABASE_URL=postgresql+psycopg://indicator:replace-with-local-password@postgres:5432/indicator
FRONTEND_PORT=5173
BACKEND_PORT=8000
